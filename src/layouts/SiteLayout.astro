---
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  robots?: string;
}

const { title, description, canonicalPath, robots = 'noindex, follow' } = Astro.props;
const canonicalUrl = canonicalPath ? new URL(canonicalPath, Astro.site).href : undefined;
const navigation = [
  { href: '/about/', label: '사이트 소개' },
  { href: '/editorial-policy/', label: '편집 원칙' },
  { href: '/privacy/', label: '개인정보 안내' },
  { href: '/contact/', label: '문의' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f7f6" />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EMFLS 스마트홈" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
  </head>
  <body>
    <div class="site-frame">
      <header class="site-header">
        <div class="header-inner">
          <a class="wordmark" href="/" aria-label="EMFLS 스마트홈 홈">
            <span class="wordmark-name">EMFLS</span>
            <span class="wordmark-section">SMART HOME</span>
          </a>
          <nav aria-label="주요 메뉴">
            <ul class="nav-list">
              {navigation.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
        </div>
      </header>
      <main id="main-content" class="page-content"><slot /></main>
      <footer class="site-footer">
        <div class="footer-inner">
          <a class="footer-home" href="/">EMFLS 스마트홈</a>
          <p>집 안의 기기와 연결 방식을 이해하기 위한 독립 정보 사이트입니다.</p>
          <ul class="footer-links" aria-label="정책 및 문의">
            {navigation.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
          <small>제품별 지원 여부와 보안 기능은 제조사 및 공식 인증 정보를 따로 확인하세요.</small>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) {
    background: #f4f7f6;
    color: #162b32;
    font-family: Inter, Pretendard, "Noto Sans KR", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }
  :global(body) { margin: 0; }
  :global(a) { color: inherit; text-underline-offset: 0.2em; }
  :global(a:focus-visible) { outline: 3px solid #635bd5; outline-offset: 4px; }
  :global(.site-frame) { min-height: 100vh; }
  .site-header { border-bottom: 1px solid #dce6e3; background: rgb(244 247 246 / 94%); }
  .header-inner, .footer-inner, :global(.content-width) { width: min(100% - 2.5rem, 74rem); margin-inline: auto; }
  .header-inner { min-height: 5.2rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .wordmark { display: grid; gap: 0.18rem; text-decoration: none; }
  .wordmark-name { font-size: 1.03rem; font-weight: 800; letter-spacing: 0.09em; }
  .wordmark-section { color: #647982; font-size: 0.63rem; font-weight: 700; letter-spacing: 0.14em; }
  .nav-list, .footer-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem 1.3rem; margin: 0; padding: 0; list-style: none; }
  .nav-list a, .footer-links a { color: #415960; font-size: 0.88rem; text-decoration: none; }
  .nav-list a:hover, .footer-links a:hover { color: #087f79; text-decoration: underline; }
  :global(.page-content) { min-height: 58vh; padding: 3.5rem 0 5rem; }
  :global(.eyebrow) { display: inline-flex; align-items: center; gap: 0.6rem; color: #087f79; font-size: 0.76rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  :global(.eyebrow::before) { width: 1.3rem; height: 2px; background: #087f79; content: ""; }
  :global(.page-title) { max-width: 15ch; margin: 0.9rem 0 1rem; color: #122930; font-size: clamp(2.4rem, 6vw, 4.5rem); font-weight: 760; letter-spacing: -0.065em; line-height: 1.12; word-break: keep-all; }
  :global(.page-lede) { max-width: 48rem; margin: 0; color: #435c63; font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.85; word-break: keep-all; }
  :global(.section-block) { margin-top: 4.2rem; }
  :global(.section-title) { margin: 0 0 1rem; color: #172f37; font-size: clamp(1.45rem, 3vw, 2rem); letter-spacing: -0.045em; line-height: 1.3; word-break: keep-all; }
  :global(.section-intro) { max-width: 48rem; margin: 0 0 1.6rem; color: #526970; line-height: 1.8; word-break: keep-all; }
  :global(.card-grid) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  :global(.info-card) { min-width: 0; padding: 1.4rem; border: 1px solid #dce6e3; border-radius: 0.85rem; background: #fff; }
  :global(.info-card h3) { margin: 0 0 0.65rem; color: #15343b; font-size: 1.08rem; letter-spacing: -0.025em; }
  :global(.info-card p) { margin: 0; color: #526970; line-height: 1.75; word-break: keep-all; }
  :global(.flow-list) { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.8rem; margin: 0; padding: 0; list-style: none; }
  :global(.flow-step) { padding: 1.1rem; border-top: 3px solid #087f79; background: #e9f1ef; }
  :global(.flow-step:nth-child(even)) { border-color: #635bd5; }
  :global(.flow-number) { color: #647982; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; }
  :global(.flow-step h3) { margin: 0.5rem 0; color: #17343b; font-size: 1.16rem; }
  :global(.flow-step p) { margin: 0; color: #4b6268; font-size: 0.92rem; line-height: 1.7; word-break: keep-all; }
  :global(.callout) { padding: 1.2rem 1.4rem; border-left: 4px solid #635bd5; background: #eeedf9; color: #30375b; line-height: 1.8; word-break: keep-all; }
  :global(.text-link) { color: #076e69; font-weight: 700; }
  :global(.article-copy) { max-width: 50rem; }
  :global(.article-copy h2) { margin: 2.5rem 0 0.8rem; color: #17343b; font-size: 1.38rem; letter-spacing: -0.04em; }
  :global(.article-copy p), :global(.article-copy li) { color: #435c63; line-height: 1.9; word-break: keep-all; }
  :global(.article-copy ul) { padding-left: 1.3rem; }
  :global(.source-list) { display: grid; gap: 1rem; margin: 1.2rem 0 0; padding: 0; list-style: none; }
  :global(.source-list li) { padding: 1.1rem 1.2rem; border: 1px solid #dce6e3; border-radius: 0.7rem; background: #fff; }
  :global(.source-list p) { margin: 0.35rem 0 0; color: #526970; line-height: 1.65; }
  :global(.simple-list) { display: grid; gap: 0.7rem; padding-left: 1.3rem; color: #435c63; line-height: 1.8; }
  :global(.site-footer) { border-top: 1px solid #dce6e3; background: #eaf0ee; }
  .footer-inner { padding-block: 2.2rem 2.8rem; }
  .footer-home { font-weight: 800; text-decoration: none; }
  .footer-inner p { margin: 0.55rem 0 1.2rem; color: #526970; line-height: 1.7; }
  .footer-links { margin-bottom: 1.2rem; }
  .footer-inner small { color: #647982; line-height: 1.6; }
  @media (max-width: 760px) {
    .header-inner { align-items: flex-start; flex-direction: column; gap: 0.8rem; padding-block: 1rem; }
    .nav-list { gap: 0.55rem 1rem; }
    .nav-list a { font-size: 0.83rem; }
    :global(.page-content) { padding-block: 2.6rem 3.8rem; }
    :global(.card-grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    :global(.flow-list) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    :global(.section-block) { margin-top: 3.2rem; }
  }
  @media (max-width: 480px) {
    .header-inner, .footer-inner, :global(.content-width) { width: min(100% - 2rem, 74rem); }
    :global(.card-grid), :global(.flow-list) { grid-template-columns: 1fr; }
    :global(.info-card), :global(.flow-step) { padding: 1rem; }
    :global(.page-title) { font-size: clamp(2.3rem, 12vw, 3rem); }
  }
</style>
