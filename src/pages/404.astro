---
import SiteLayout from '../layouts/SiteLayout.astro';

const title = '페이지를 찾을 수 없습니다 | EMFLS 스마트홈';
const description = '요청한 주소의 페이지를 찾을 수 없습니다. EMFLS 스마트홈 홈으로 돌아가 연결 구조와 자동화 안내를 살펴보세요.';
---

<SiteLayout title={title} description={description} robots="noindex, follow">
  <section class="content-width not-found" aria-labelledby="not-found-title">
    <p class="eyebrow">404 · Page not found</p>
    <h1 id="not-found-title" class="page-title">페이지를 찾을 수 없습니다</h1>
    <p class="page-lede">주소가 바뀌었거나 입력이 잘못되었을 수 있습니다. 홈으로 돌아가 스마트홈 연결과 자동화의 기본 흐름을 확인해 보세요.</p>
    <p><a class="primary-link" href="/">스마트홈 안내 홈으로 <span aria-hidden="true">→</span></a></p>
  </section>
</SiteLayout>

<style>
  .not-found { padding-block: 2.5rem 6rem; }
  .primary-link { display: inline-flex; gap: 1rem; align-items: center; padding: 0.85rem 1.05rem; border-radius: 0.45rem; background: #087f79; color: #fff; font-size: 0.93rem; font-weight: 750; text-decoration: none; }
</style>
